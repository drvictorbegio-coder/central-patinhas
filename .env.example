# Variáveis de ambiente — configure na Vercel em: Project → Settings → Environment Variables.
# NUNCA coloque os valores reais no código nem no GitHub.

# Supabase → Project Settings → API (ou "API Keys")
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role-ou-secret

# Código secreto usado UMA vez para criar o primeiro administrador (invente uma frase longa)
SETUP_TOKEN=invente-um-codigo-longo-aqui

# Opcionais
# APP_URL=https://central-patinhas.vercel.app
# LOGIN_EMAIL_DOMAIN=equipe.patinhasdeassis.local
